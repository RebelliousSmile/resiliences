; Godot 4 project file — RÉSILIENCES
;
; Ordre des autoloads :
;   1. État central (GameStateManager)
;   2. Managers métier (Lumen, Relation, Menace, Inventaire, Craft)
;   3. Gestionnaires de scènes interactives (Conflit, Assemblée)
;   4. Sauvegarde (dépend de tous les autres)
;   5. Pont Dialogic (dépend de tous les managers)

config_version=5

[application]

config/name="RÉSILIENCES"
run/main_scene="res://scenes/acte1/s1_01.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameStateManager="*res://autoloads/GameStateManager.gd"
LumenManager="*res://autoloads/LumenManager.gd"
RelationManager="*res://autoloads/RelationManager.gd"
MenaceManager="*res://autoloads/MenaceManager.gd"
InventaireManager="*res://autoloads/InventaireManager.gd"
CraftManager="*res://autoloads/CraftManager.gd"
ConflitManager="*res://autoloads/ConflitManager.gd"
AssembleeVoteManager="*res://autoloads/AssembleeVoteManager.gd"
SaveManager="*res://autoloads/SaveManager.gd"
DialogicBridge="*res://autoloads/DialogicBridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

clic_principal={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
echap={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":true,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
ouvrir_inventaire={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":true,"keycode":73,"physical_keycode":0,"key_label":0,"unicode":105,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
